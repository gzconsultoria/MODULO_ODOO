<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_goal_tree" model="ir.ui.view">
        <field name="name">finance.goal.tree</field>
        <field name="model">finance.goal</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_late" decoration-success="state == 'achieved'">
                <field name="name"/>
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="goal_type"/>
                <field name="target_amount" widget="monetary"/>
                <field name="accumulated_amount" widget="monetary"/>
                <field name="progress_ratio" widget="percentpie"/>
                <field name="horizon_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_goal_form" model="ir.ui.view">
        <field name="name">finance.goal.form</field>
        <field name="model">finance.goal</field>
        <field name="arch" type="xml">
            <form string="Meta financeira">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="profile_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="goal_type"/>
                            <field name="state" widget="statusbar" statusbar_visible="draft,active,achieved,archived"/>
                        </group>
                        <group>
                            <field name="target_amount"/>
                            <field name="accumulated_amount"/>
                            <field name="periodic_contribution"/>
                            <field name="probability"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="horizon_date"/>
                            <field name="progress_ratio" widget="percentpie" readonly="1"/>
                            <field name="is_late" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrição">
                            <field name="description" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_finance_goal_search" model="ir.ui.view">
        <field name="name">finance.goal.search</field>
        <field name="model">finance.goal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="profile_id"/>
                <filter string="Atrasadas" domain="[('is_late', '=', True)]"/>
                <filter string="Ativas" domain="[('state', '=', 'active')]"/>
            </search>
        </field>
    </record>

    <record id="action_finance_goal" model="ir.actions.act_window">
        <field name="name">Metas financeiras</field>
        <field name="res_model">finance.goal</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_finance_planning_root" name="Planejamento" parent="finance_core.menu_finance_root" sequence="30"/>
    <menuitem id="menu_finance_goal" parent="menu_finance_planning_root" name="Metas" action="action_finance_goal" sequence="10"/>
</odoo>
