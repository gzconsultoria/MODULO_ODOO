<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_cashflow_plan_tree" model="ir.ui.view">
        <field name="name">finance.cashflow.plan.tree</field>
        <field name="model">finance.cashflow.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="profile_id"/>
                <field name="date"/>
                <field name="monthly_income" widget="monetary"/>
                <field name="monthly_expense" widget="monetary"/>
                <field name="monthly_surplus" widget="monetary"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_cashflow_plan_form" model="ir.ui.view">
        <field name="name">finance.cashflow.plan.form</field>
        <field name="model">finance.cashflow.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="profile_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="monthly_income" readonly="1"/>
                            <field name="monthly_expense" readonly="1"/>
                            <field name="monthly_surplus" readonly="1"/>
                        </group>
                    </group>
                    <field name="item_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="entry_type"/>
                            <field name="category"/>
                            <field name="periodicity"/>
                            <field name="amount"/>
                            <field name="actual_amount"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_cashflow_plan" model="ir.actions.act_window">
        <field name="name">Planejamentos de caixa</field>
        <field name="res_model">finance.cashflow.plan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_finance_cashflow_plan" parent="menu_finance_planning_root" name="Fluxo de caixa" action="action_finance_cashflow_plan" sequence="20"/>
</odoo>
