<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_goal_wizard" model="ir.ui.view">
        <field name="name">finance.goal.wizard.form</field>
        <field name="model">finance.goal.wizard</field>
        <field name="arch" type="xml">
            <form string="Nova meta" create="false" edit="false">
                <group>
                    <field name="profile_id" readonly="1"/>
                    <field name="template_id" options="{'no_open': True}"/>
                    <field name="name"/>
                    <field name="goal_type"/>
                    <field name="target_amount"/>
                    <field name="horizon_date"/>
                    <field name="periodic_contribution"/>
                </group>
                <footer>
                    <button name="action_create_goal" type="object" string="Criar meta" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
