<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_recommendation_tree" model="ir.ui.view">
        <field name="name">finance.recommendation.tree</field>
        <field name="model">finance.recommendation</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'ack'" decoration-danger="state == 'rejected'">
                <field name="recommendation_date"/>
                <field name="profile_id"/>
                <field name="company_id"/>
                <field name="goal_id"/>
                <field name="state"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_recommendation_form" model="ir.ui.view">
        <field name="name">finance.recommendation.form</field>
        <field name="model">finance.recommendation</field>
        <field name="arch" type="xml">
            <form string="Recomendação">
                <header>
                    <button name="action_send" type="object" string="Enviar" states="draft" class="btn-primary"/>
                    <button name="action_acknowledge" type="object" string="Registrar ciência" states="sent" class="btn-secondary"/>
                    <button name="action_reject" type="object" string="Registrar recusa" states="sent" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,ack,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="goal_id"/>
                            <field name="recommendation_date"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="pdf_report_attachment_id"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="narrative" widget="html"/>
                        <field name="impact_overview" widget="text"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="reference_id"/>
                            <field name="action_type"/>
                            <field name="amount"/>
                            <field name="rationale_plain"/>
                            <field name="risk_notes"/>
                            <field name="impact_summary"/>
                        </tree>
                    </field>
                    <group>
                        <field name="compliance_log_ids" readonly="1">
                            <tree>
                                <field name="create_date"/>
                                <field name="event"/>
                                <field name="description"/>
                                <field name="user_id"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_finance_recommendation" model="ir.actions.act_window">
        <field name="name">Recomendações</field>
        <field name="res_model">finance.recommendation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_finance_recommendation" parent="finance_core.menu_finance_root" name="Recomendações" action="action_finance_recommendation" sequence="50"/>
</odoo>
