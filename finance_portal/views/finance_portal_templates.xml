<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_finance" name="Portal Financeiro">
        <t t-call="portal.portal_layout">
            <t t-if="not profile">
                <t t-call="finance_portal.portal_no_finance_profile"/>
            </t>
            <t t-else="">
                <section class="o_finance_portal bg-light py-4" id="wrap">
                    <div class="container o_portal">
                        <div class="row g-4">
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body text-center">
                                        <span class="display-4 text-primary">💼</span>
                                        <h5 class="mt-3">Patrimônio</h5>
                                        <div class="fs-4" t-esc="profile.portfolio_value" t-options="{'widget': 'monetary', 'display_currency': profile.currency_id}"/>
                                        <p class="text-muted mb-0">Score financeiro: <span class="fw-semibold" t-esc="profile.advisory_score"/></p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body text-center">
                                        <span class="display-4 text-success">🎯</span>
                                        <h5 class="mt-3">Metas</h5>
                                        <p class="text-muted mb-1">Progresso médio</p>
                                        <div class="progress" style="height: 12px;">
                                            <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: %s%%' % (profile.goals_progress * 100)" t-esc="round(profile.goals_progress * 100)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body text-center">
                                        <span class="display-4 text-info">📈</span>
                                        <h5 class="mt-3">Fluxo mensal</h5>
                                        <div class="fs-4" t-esc="profile.cashflow_balance" t-options="{'widget': 'monetary', 'display_currency': profile.currency_id}"/>
                                        <p class="text-muted mb-0">Próxima revisão: <span class="fw-semibold" t-esc="profile.suitability_next_review"/></p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-body text-center">
                                        <span class="display-4 text-warning">🔔</span>
                                        <h5 class="mt-3">Alertas</h5>
                                        <p class="fs-4" t-esc="profile.pending_documents"/>
                                        <p class="text-muted mb-0">Documentos ou tarefas pendentes</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mt-3">
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Metas</h5>
                                        <a class="btn btn-sm btn-outline-primary" t-att-href="'/web#id=%s&model=finance.goal&view_type=form' % goal.id if goals else '#'" t-if="goals">Ver detalhes</a>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="goals">
                                            <t t-foreach="goals" t-as="goal">
                                                <div class="mb-3">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="fw-semibold" t-esc="goal.name"/>
                                                        <span class="text-muted" t-esc="goal.horizon_date"/>
                                                    </div>
                                                    <div class="progress" style="height: 10px;">
                                                        <div class="progress-bar" t-att-class="'progress-bar ' + ('bg-success' if goal.progress_ratio >= 0.8 else 'bg-info')" t-att-style="'width: %s%%' % (goal.progress_ratio * 100)"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">Nenhuma meta cadastrada ainda.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0">
                                        <h5 class="mb-0">Carteira</h5>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="snapshot">
                                            <p class="text-muted">Atualizado em <span class="fw-semibold" t-esc="snapshot.snapshot_date"/></p>
                                            <table class="table table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Ativo</th>
                                                        <th class="text-end">Valor</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="snapshot.position_ids" t-as="position">
                                                        <tr>
                                                            <td t-esc="position.reference_id.display_name"/>
                                                            <td class="text-end" t-esc="position.market_value" t-options="{'widget': 'monetary', 'display_currency': snapshot.currency_id}"/>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                            <t t-if="snapshot.allocation_warning">
                                                <div class="alert alert-warning" t-esc="snapshot.allocation_warning"/>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">Sem snapshots registrados ainda.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mt-3">
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0">
                                        <h5 class="mb-0">Recomendações recentes</h5>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="recommendations">
                                            <t t-foreach="recommendations" t-as="recommendation">
                                                <div class="mb-3">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="fw-semibold" t-esc="recommendation.recommendation_date"/>
                                                        <span class="badge rounded-pill" t-att-class="'bg-success' if recommendation.state == 'ack' else ('bg-warning' if recommendation.state == 'sent' else 'bg-danger')" t-esc="recommendation.state"/>
                                                    </div>
                                                    <div class="text-muted" t-raw="recommendation.narrative"/>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">Nenhuma recomendação disponível.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Documentos</h5>
                                        <span class="badge bg-warning" t-if="documents.filtered('is_expired')">Pendências</span>
                                    </div>
                                    <div class="card-body">
                                        <form t-att-action="'/my/finance/upload'" method="post" enctype="multipart/form-data" class="mb-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="row g-2 align-items-center">
                                                <div class="col">
                                                    <input type="file" name="document_file" class="form-control" required="required"/>
                                                </div>
                                                <div class="col">
                                                    <select name="category" class="form-select">
                                                        <option value="other">Outro</option>
                                                        <option value="suitability">Suitability</option>
                                                        <option value="policy">Política de investimento</option>
                                                        <option value="report">Relatório</option>
                                                    </select>
                                                </div>
                                                <div class="col">
                                                    <button type="submit" class="btn btn-primary w-100">Enviar</button>
                                                </div>
                                            </div>
                                        </form>
                                        <div class="list-group">
                                            <t t-foreach="documents" t-as="doc">
                                                <a t-att-href="'/web/content/%s?download=true' % doc.attachment_id.id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                    <span>
                                                        <i class="fa fa-file-text-o me-2"/>
                                                        <t t-esc="doc.name"/>
                                                    </span>
                                                    <span class="badge" t-att-class="'bg-danger' if doc.is_expired else 'bg-secondary'" t-esc="doc.expiration_date or 'Sem vencimento'"/>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mt-3">
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0">
                                        <h5 class="mb-0">Próximas reuniões</h5>
                                    </div>
                                    <div class="card-body">
                                        <t t-if="meetings">
                                            <t t-foreach="meetings" t-as="meeting">
                                                <div class="mb-3">
                                                    <div class="fw-semibold" t-esc="meeting.start"/>
                                                    <div class="text-muted" t-esc="meeting.name"/>
                                                    <t t-if="meeting.finance_recording_url">
                                                        <a t-att-href="meeting.finance_recording_url" class="text-decoration-none">📼 Gravação</a>
                                                    </t>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">Nenhuma reunião agendada.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-0">
                                        <h5 class="mb-0">Enviar mensagem</h5>
                                    </div>
                                    <div class="card-body">
                                        <form action="/my/finance/message" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <textarea name="message" class="form-control" rows="4" placeholder="Escreva sua mensagem" required="required"/>
                                            <button type="submit" class="btn btn-outline-primary mt-3">Enviar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </t>
    </template>

    <template id="portal_no_finance_profile">
        <section class="o_finance_portal_empty text-center py-5">
            <div class="container">
                <h3 class="mb-3">Portal financeiro em configuração</h3>
                <p class="text-muted">Ainda não há informações financeiras disponíveis. Entre em contato com seu consultor para liberar o acesso.</p>
            </div>
        </section>
    </template>
</odoo>
