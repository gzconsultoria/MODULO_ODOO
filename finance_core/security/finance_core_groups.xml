<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_finance_consultant" model="res.groups">
        <field name="name">Consultor Financeiro</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_finance_backoffice" model="res.groups">
        <field name="name">Backoffice Financeiro</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_consultant'))]"/>
    </record>
    <record id="group_finance_compliance" model="res.groups">
        <field name="name">Compliance Financeiro</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_finance_supervisor" model="res.groups">
        <field name="name">Supervisor Financeiro</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_consultant')), (4, ref('group_finance_compliance'))]"/>
    </record>
</odoo>
