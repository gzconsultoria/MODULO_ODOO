<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="finance_profile_rule_portal" model="ir.rule">
        <field name="name">Portal - Perfil financeiro</field>
        <field name="model_id" ref="model_finance_profile"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="finance_alert_rule_portal" model="ir.rule">
        <field name="name">Portal - Alertas</field>
        <field name="model_id" ref="model_finance_alert"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('profile_id.partner_id', 'child_of', [user.partner_id.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
