<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finance_review_wizard" model="ir.ui.view">
        <field name="name">finance.review.wizard.form</field>
        <field name="model">finance.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Revisão trimestral" class="o_finance_review_wizard">
                <sheet>
                    <group>
                        <group>
                            <field name="profile_id" readonly="1"/>
                            <field name="portfolio_id"/>
                            <field name="review_date"/>
                        </group>
                        <group>
                            <field name="include_snapshot"/>
                            <field name="create_meeting"/>
                            <field name="meeting_datetime" modifiers="{'invisible': [('create_meeting', '=', False)]}"/>
                            <field name="create_followup_activity"/>
                        </group>
                    </group>
                    <group>
                        <field name="deviation_summary" widget="text" readonly="1" string="Alertas"/>
                    </group>
                    <group>
                        <field name="notes" widget="text"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Concluir revisão" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
