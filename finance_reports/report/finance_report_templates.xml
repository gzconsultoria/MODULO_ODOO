<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="finance_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>Relatório 360° - <t t-esc="doc.partner_id.name"/></h2>
                    <p>Consultor responsável: <t t-esc="doc.advisor_id.name"/></p>
                    <h3>Resumo financeiro</h3>
                    <ul>
                        <li>Score financeiro: <t t-esc="doc.advisory_score"/></li>
                        <li>AUM consolidado: <span t-esc="doc.currency_id.symbol"/> <t t-esc="doc.portfolio_value"/></li>
                        <li>Fluxo de caixa mensal: <span t-esc="doc.currency_id.symbol"/> <t t-esc="doc.cashflow_balance"/></li>
                        <li>Progresso médio das metas: <t t-esc="doc.goals_progress"/>%</li>
                    </ul>
                    <h3>Metas</h3>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Meta</th>
                                <th>Progresso</th>
                                <th>Prazo</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="get_goal_cards(doc)" t-as="goal">
                                <tr>
                                    <td><t t-esc="goal['name']"/></td>
                                    <td><t t-esc="goal['progress']"/>%</td>
                                    <td><t t-esc="goal['horizon']"/></td>
                                    <td><t t-esc="goal['state']"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-set="snapshot" t-value="get_portfolio_snapshot(doc)"/>
                    <t t-if="snapshot">
                        <h3>Carteira</h3>
                        <p>Valor: <span t-esc="doc.currency_id.symbol"/> <t t-esc="snapshot['value']"/> em <t t-esc="snapshot['date']"/></p>
                        <t t-if="snapshot['warning']">
                            <p><strong>Alertas:</strong> <t t-esc="snapshot['warning']"/></p>
                        </t>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Ativo</th>
                                    <th>Quantidade</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="snapshot['positions']" t-as="position">
                                    <tr>
                                        <td><t t-esc="position['asset']"/></td>
                                        <td><t t-esc="position['quantity']"/></td>
                                        <td><span t-esc="doc.currency_id.symbol"/> <t t-esc="position['value']"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                    <h3>Compliance</h3>
                    <ul>
                        <t t-foreach="doc.compliance_log_ids[:5]" t-as="log">
                            <li><t t-esc="log.create_date"/> - <t t-esc="log.description"/></li>
                        </t>
                    </ul>
                </div>
            </t>
        </t>
    </template>
</odoo>
